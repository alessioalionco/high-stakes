#!/bin/sh
# high-stakes — entry point for the engine's commands.
#
# It exists because `python3 -m high_stakes.X` only works if the package is already on
# sys.path — which is true in the author's repository and false on the machine of whoever
# installs the plugin. The symptom was a ModuleNotFoundError from any real directory, and
# the smoke test did not catch it because it set PYTHONPATH itself.
#
# This script resolves the package root from its OWN location, so it works from any cwd,
# with no install, no environment variable, and no pip.
#
#   bin/high-stakes render_gate <report.md>
#   bin/high-stakes qverify <report.md> <cells_dir>
#   bin/high-stakes render_dossier <report.md> [out.html]
#   bin/high-stakes paths core
#   bin/high-stakes config
set -eu

if [ "$#" -lt 1 ]; then
    echo "usage: high-stakes <command> [args...]" >&2
    echo "commands: render_gate · qverify · render_dossier · paths · config" >&2
    exit 2
fi

# Resolve symlinks before the dirname: `ln -s .../bin/high-stakes ~/.local/bin/high-stakes`
# is the standard way to put a launcher on the PATH, and without dereferencing, the
# dirname would point at ~/.local/bin — reproducing the ModuleNotFoundError this script
# exists to kill.
#
# The loop HAS an iteration cap: a symlink cycle (a -> b -> a) made it run forever, and
# the user saw the command hang without a single line of output — worse than an error,
# because there is nothing to report and nothing to search for. 40 is the same ceiling
# the kernel uses for link resolution; a legitimate chain never comes close.
SRC="$0"
HOPS=0
while [ -L "$SRC" ]; do
    HOPS=$((HOPS + 1))
    if [ "$HOPS" -gt 40 ]; then
        echo "high-stakes: symlink chain too long starting from '$0'" >&2
        echo "  (more than 40 hops — probably a cycle: a -> b -> a)." >&2
        echo "  Run 'ls -l' on the path above, or call the script by its real path." >&2
        exit 2
    fi
    LINK=$(readlink "$SRC")
    case "$LINK" in
        /*) SRC="$LINK" ;;
        *)  SRC="$(dirname -- "$SRC")/$LINK" ;;
    esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SRC")/.." && pwd)
CMD="$1"
shift

exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
     python3 -m "high_stakes.$CMD" "$@"
