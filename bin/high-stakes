#!/bin/sh
# high-stakes — ponto de entrada dos comandos do motor.
#
# Existe porque `python3 -m high_stakes.X` só funciona se o pacote já estiver no
# sys.path — o que é verdade no repositório do autor e falso na máquina de quem instala
# o plugin. O sintoma era ModuleNotFoundError de qualquer diretório real, e o smoke test
# não pegava porque ele mesmo setava PYTHONPATH.
#
# Este script resolve a raiz do pacote a partir da PRÓPRIA localização, então funciona de
# qualquer cwd, sem instalação, sem variável de ambiente e sem pip.
#
#   bin/high-stakes render_gate <report.md>
#   bin/high-stakes qverify <report.md> <cells_dir>
#   bin/high-stakes render_dossier <report.md> [out.html]
#   bin/high-stakes paths core
#   bin/high-stakes config
set -eu

if [ "$#" -lt 1 ]; then
    echo "uso: high-stakes <comando> [args...]" >&2
    echo "comandos: render_gate · qverify · render_dossier · paths · config" >&2
    exit 2
fi

# Resolve symlinks antes do dirname: `ln -s .../bin/high-stakes ~/.local/bin/high-stakes`
# é a forma padrão de pôr um launcher no PATH, e sem desreferenciar o dirname apontaria
# para ~/.local/bin — reproduzindo o ModuleNotFoundError que este script existe para matar.
#
# O laço TEM cap de iteração: um ciclo de symlink (a -> b -> a) fazia ele rodar para
# sempre, e o usuário via o comando pendurado sem uma linha de saída — pior que um erro,
# porque não há o que reportar nem o que procurar. 40 é o mesmo teto que o kernel usa
# para resolução de link; cadeia legítima nunca chega perto.
SRC="$0"
SALTOS=0
while [ -L "$SRC" ]; do
    SALTOS=$((SALTOS + 1))
    if [ "$SALTOS" -gt 40 ]; then
        echo "high-stakes: cadeia de symlinks longa demais a partir de '$0'" >&2
        echo "  (mais de 40 saltos — provavelmente um ciclo: a -> b -> a)." >&2
        echo "  Rode 'ls -l' no caminho acima, ou chame o script pelo caminho real." >&2
        exit 2
    fi
    LINK=$(readlink "$SRC")
    case "$LINK" in
        /*) SRC="$LINK" ;;
        *)  SRC="$(dirname -- "$SRC")/$LINK" ;;
    esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$SRC")/.." && pwd)
CMD="$1"
shift

exec env PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
     python3 -m "high_stakes.$CMD" "$@"
